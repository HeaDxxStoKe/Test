# Strava OAuth-Zugangsdaten.
# Anlegen unter: https://www.strava.com/settings/api
#
# Kopiere diese Datei nach `.env.local` und trage deine Werte ein.

# Client-ID deiner Strava-API-Anwendung
STRAVA_CLIENT_ID=

# Client-Secret deiner Strava-API-Anwendung (bleibt serverseitig, niemals öffentlich!)
STRAVA_CLIENT_SECRET=

# Basis-URL der App. Muss in Strava als "Authorization Callback Domain" hinterlegt sein.
# Lokal reicht als Domain "localhost".
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Zufälliges Secret zum Signieren des Session-Cookies (min. 32 Zeichen).
# Beispiel erzeugen: `openssl rand -base64 32`
SESSION_SECRET=
